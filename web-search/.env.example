# web-search skill API keys (template — no real keys)
#
# Copy this file to ~/.claude/.secrets/web-search.env and fill in your own keys:
#   cp .env.example ~/.claude/.secrets/web-search.env
#   # then edit ~/.claude/.secrets/web-search.env with real values
#
# All 6 scripts auto-load that file at startup, so you do NOT need a shell
# env prefix like `ZHIHU_ACCESS_SECRET=... python3 zhihu-search.py ...`.
#
# Where to get keys:
#   TAVILY_API_KEY        https://app.tavily.com  (free tier available)
#   FIRECRAWL_API_KEY     https://firecrawl.dev  (used by both Firecrawl engines)
#   ZHIHU_ACCESS_SECRET   https://developer.zhihu.com  (OpenAPI Bearer secret)
#   EXA_API_KEY           https://dashboard.exa.ai  (x-api-key header; deep/deep-reasoning synthesis)
#
# Multi-key quota fallback (Tavily / Firecrawl only):
#   *_API_KEYS  = comma-separated list, PRIMARY FIRST then fallbacks.
#                 Scripts auto-switch to the next key when one is exhausted (402/429).
#   *_API_KEY   = single-key fallback, used only if *_API_KEYS is not set.
#                 Kept for backward compat; *_API_KEYS takes precedence when both exist.

TAVILY_API_KEY=tvly-your-key-here
TAVILY_API_KEYS=tvly-your-primary-key,tvly-your-fallback-key
FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_API_KEYS=fc-your-primary-key,fc-your-fallback-key
ZHIHU_ACCESS_SECRET=your-zhihu-secret-here
EXA_API_KEY=your-exa-key-here
